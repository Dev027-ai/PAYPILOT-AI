# PayPilot AI local development configuration. Copy this file to .env and replace placeholders.
# Never commit .env or paste secret values into chat.

# ---- PayPal Sandbox (required for real Sandbox checkout) ----
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=replace-with-sandbox-rest-app-client-id
PAYPAL_CLIENT_SECRET=replace-with-sandbox-rest-app-secret
PAYPAL_MERCHANT_ID=replace-with-sandbox-business-account-id

# ---- AI assistant (Gemini free tier is the recommended default) ----
AI_PROVIDER=gemini
GEMINI_API_KEY=replace-with-google-ai-studio-api-key
GEMINI_MODEL=gemini-3.8-flash
# Optional alternative: AI_PROVIDER=openai and set OPENAI_API_KEY.
# OPENAI_API_KEY=replace-with-openai-api-key
# OPENAI_MODEL=gpt-5.4-mini

# ---- PostgreSQL (required; use a database you control, e.g. Supabase or Neon) ----
# Replace the entire URL with the connection string from your PostgreSQL provider.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# ---- Local web/API settings ----
PORT=8080
WEB_PORT=23943
BASE_PATH=/
PAYPILOT_API_URL=http://127.0.0.1:8080
PAYPILOT_APP_ORIGIN=http://localhost:23943
CORS_ALLOWED_ORIGINS=http://localhost:23943,http://127.0.0.1:23943
